# MongoDB Connection String (required)
# Get your free MongoDB Atlas connection string: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smartmedicinefinder?retryWrites=true&w=majority

# Server Port (optional, default: 5000)
PORT=5000

# Client Origin for CORS (optional, default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Optional: set a specific Python executable if you want to override the workspace venv.
# Example on Windows: PYTHON_BIN=C:/Program Files/Python313/python.exe
PYTHON_BIN=

# Optional: OpenAI API key for OCR refinement, search intent, and medicine suggestions.
OPENAI_API_KEY=

# Optional: OpenAI model to use for AI features.
OPENAI_MODEL=gpt-4o-mini
